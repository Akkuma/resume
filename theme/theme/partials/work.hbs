{{#if resume.work.length}}
<section class="section">
  <header>
    <h2 class='section-title'>Work Experience</h2>
  </header>

  <section id="work">
    {{#each resume.work}}
    <section class="work-item">
        {{#if summary}}
        <label for="work-item-{{@index}}"></label>
        {{/if}}

        <header class="clear">
          <div class="date">
            {{#if startDate}}
            <span class="startDate">{{MY startDate}}</span>
            {{/if}}
            {{#if endDate}}
            <span class="endDate">- {{MY endDate}}</span>
            {{else}}
            <span class="endDate">- Current</span>
            {{/if}}
          </div>
          {{#if position}}
          <div class="position">{{position}}</div>
          {{/if}}
          {{#if website}}
            <span class="company">
              <a target="_blank" href="{{website}}">{{name}}</a>
            </span>
          {{else}}
            <div class="company">{{name}}</div>
          {{/if}}
        </header>

      {{#if location}}
        <span class="location">
          <span class="fas fa-map-marker-alt"></span>
          {{#isObject location}}
            {{#with ../location}}
              {{#if city}}
              <span class="city">{{city}}</span>
              {{/if}}
              {{#if region}}
              <span class="region">{{region}}</span>
              {{/if}}
            {{/with}}
          {{else}}
            <span class="location">{{../location}}</span>
          {{/isObject}}
        </span>
      {{/if}}
      {{#if url}}
      <span class="url">
        {{#if logo}}
          <img class="logo" src="{{logo}}" />
        {{else}}
          <span class="fas fa-external-link-alt"></span>
        {{/if}}
        <a target="_blank" href="{{url}}">{{stripHttp url}}</a>
      </span>
      {{/if}} 
      {{#if keywords.length}}
      <ul class="keywords">
        {{#each keywords}}
        <li>{{lowercase .}}</li>
        {{/each}}
      </ul>
      {{/if}}
      <div class="item" id="work-item">
        {{#if summary}}
        <div class="summary">{{paragraphSplit summary}}</div>
        {{/if}}
        {{#if highlights.length}}
        <ul class="highlights">
          {{#each highlights}}
          <li>{{paragraphSplit .}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
    </section>
    {{/each}}
  </section>
</section>
{{/if}}